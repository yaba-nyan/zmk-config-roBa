#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball_listener {
    input-processors = <&zip_temp_layer 1 700>;

    scroll {
        layers = <5>;
        input-processors = <&zip_xy_scaler 1 16 &zip_xy_to_scroll_mapper &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <2 4 3 1 5 6 0>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <2 3 4 1 5 0 6>;
        };

        esc {
            bindings = <&to_layer_0 ESC>;
            key-positions = <11 10>;
            layers = <0 2 3 4 1 5 6>;
        };

        snap-to-next-disp {
            bindings = <&kp LS(LG(RIGHT))>;
            key-positions = <11 12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        sleep_macro: sleep_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(X)>,
                <&macro_wait_time 1000>,
                <&kp U>,
                <&macro_wait_time 500>,
                <&kp S>;

            label = "SLEEP_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        my_tap_hold: my_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_TAP_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 18 30 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                 &kp T                                                    &kp Y            &kp U  &kp I             &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                 &kp G        &kp LS(LG(S))             &kp SEMICOLON     &kp H            &kp J  &my_tap_hold 5 K  &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                 &kp B        &kp GRAVE                 &kp SINGLE_QUOTE  &kp N            &kp M  &kp COMMA         &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 F15  &lt 3 SPACE  &lt_to_layer_0 3 F13      &kp ENTER         &lt 2 BACKSPACE                                    &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                            &kp LS(LG(LEFT))  &kp HOME        &kp UP_ARROW       &kp END          &kp LG(TAB)
&kp F6  &kp F7  &trans  &kp F8   &kp F9   &kp F10      &kp LC(W)   &kp LS(LC(TAB))   &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT_ARROW  &kp LC(TAB)
&trans  &trans  &trans  &kp F11  &kp F12  &trans       &kp LA(F4)  &kp C_VOL_DN      &kp PAGE_UP     &kp LC(BACKSPACE)  &kp PAGE_DOWN    &kp C_VOL_UP
&trans  &trans  &trans  &trans   &trans   &trans       &trans      &trans                                                                &sleep_macro
            >;
        };

        NUM {
            bindings = <
&kp MINUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp ASTRK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans             &trans        &trans        &trans        &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans     &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &mkp MB1   &trans    &mkp MB2  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &kp LC(W)  &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4                                 &trans
            >;
        };

        Bluetooth {
            bindings = <
&kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &to 7       &trans       &trans        &trans        &trans        &trans        &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&kp SPACE  &trans     &trans     &trans     &trans     &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        Game {
            bindings = <
&kp Q   &kp W   &kp E   &kp R   &kp T                             &kp Y          &kp U  &kp I      &kp O       &kp P
&kp A   &kp S   &kp D   &kp F   &kp G      &trans      &trans     &kp H          &kp J  &kp K      &kp L       &kp MINUS
&kp Z   &kp X   &kp C   &kp V   &kp B      &trans      &trans     &kp N          &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&trans  &trans  &trans  &trans  &kp SPACE  &trans      &kp ENTER  &kp BACKSPACE                                &to 0
            >;
        };
    };
};
